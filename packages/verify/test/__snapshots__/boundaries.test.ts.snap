// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshots every existing exact finding template including positive/info 1`] = `
{
  "otherLiteralMessages": [
    ""This check couldn't run, so we can't call this safe."",
    ""A required check didn't run, so we can't call this safe."",
    ""Don't send yet. Copy the address again, or ask your swap app for a new quote."",
    ""NEAR Intents didn't answer. Wait a minute and try again before you send."",
  ],
  "rules": {
    ""ADDRESS_FORMAT_NO_CHECKSUM_SIGNED_MATCH"": ""Address format is valid. It's all lowercase, so we couldn't use its checksum and compared it with the signed quote character by character instead."",
    ""ADDRESS_FORMAT_UNSUPPORTED"": "\`We don't check \${name} address formats yet, so look at it carefully.\`",
    ""ADDRESS_FORMAT_VALID"": ""Address format is valid for this network."",
    ""ADDRESS_LOOKALIKE"": "\`\${where} isn't the quote's address. It looks similar, but the middle is different. Copy it again from your swap app.\`",
    ""ADDRESS_MATCH"": ""Address matches the quote, character for character."",
    ""ADDRESS_MISMATCH"": "\`\${where} isn't the quote's address. Copy it again from your swap app.\`",
    ""ADDRESS_NO_CHECKSUM"": ""This address is all lowercase, so we can't use its checksum. We compared it character by character instead."",
    ""AMOUNT_ABOVE_QUOTE"": "\`The entered amount exceeds the quote by \${fmtOrigin(c, sent - amountIn)}. Reduce it; any excess refund depends on provider processing and fees.\`",
    ""AMOUNT_AT_OR_BELOW_REFUND_FEE"": ""This amount is tiny. If it's refunded, fees could take most of it."",
    ""AMOUNT_BELOW_QUOTE"": "\`This quote needs \${fmtOrigin(c, need)}. You entered \${fmtOrigin(c, sent)}. Do not send; refund handling depends on NEAR Intents and may include fees.\`",
    ""AMOUNT_EXACT_OUTPUT_SUFFICIENT"": "\`Amount is enough. The quote suggests \${fmtOrigin(c, amountIn)}; at least \${fmtOrigin(c, minIn)} is needed.\`",
    ""AMOUNT_FLEX_INPUT_SUFFICIENT"": "\`Amount is enough. This swap accepts at least \${fmtOrigin(c, minIn)}.\`",
    ""AMOUNT_MATCH"": "\`The entered amount matches the quote: \${fmtOrigin(c, sent)}.\`",
    ""AMOUNT_MISSING"": ""Enter the amount you'll send so we can compare it with the quote."",
    ""AMOUNT_TOKEN_PRECISION_MISMATCH"": ""You're sending a different token than the quote, so we can't compare amounts."",
    ""CHAIN_ID_CONFLICT"": "\`Your wallet is on chain ID \${c.chainIdConflict.chainId}, which isn't \${onName}. This address is for \${expectedName}.\`",
    ""CHAIN_ID_UNKNOWN"": "\`We don't recognise chain ID \${c.unknownChainId}. This quote expects \${expectedName}.\`",
    ""CONFIDENTIAL_DEPOSIT_UNSUPPORTED"": ""This quote is funded from Confidential Intents. Neer doesn't check those yet."",
    ""CONFIDENTIAL_SWAP_UNSUPPORTED"": ""Neer doesn't check confidential swaps yet, so we can't tell you if this one is right."",
    ""DATA_FRESH"": ""Checked just now."",
    ""DEPOSIT_ADDRESS_INACTIVE"": ""This deposit address has gone quiet, so the swap may take longer than usual."",
    ""DEPOSIT_ADDRESS_INVALID"": "\`This doesn't look like a \${name} address. Copy it again from your swap app.\`",
    ""DEPOSIT_ALREADY_USED"": ""This address was already used. Each deposit address works once. Get a new quote."",
    ""DEPOSIT_INCOMPLETE"": ""NEAR Intents reports an incomplete deposit. Don't send more here; check refund status with your swap app."",
    ""DEPOSIT_IN_USE"": ""A deposit to this address is already on its way. Each deposit address works once. Don't send again; track it instead."",
    ""DEPOSIT_PENDING"": ""This address is waiting for your deposit."",
    ""DEPOSIT_STATUS_UNKNOWN"": ""We couldn't see whether this address is still waiting for a deposit. Check again before you send."",
    ""DRAFT_APPROVAL"": ""This isn't a deposit. Your wallet is asking to approve spending, not to send. A NEAR Intents deposit never needs an approval."",
    ""DRAFT_NETWORK_UNSUPPORTED"": ""Draft transaction decoding only covers EVM networks. Do not treat an EVM draft as proof of a transfer on another network."",
    ""DRAFT_NOT_PLAIN_TRANSFER"": ""This isn't a plain transfer. A NEAR Intents deposit is a simple send of the token to the deposit address."",
    ""DRAFT_PLAIN_TRANSFER"": ""This is a plain transfer. No approvals involved."",
    ""FORMAT_NETWORK_UNKNOWN"": ""We couldn't check the address format because we don't know the network."",
    ""INCIDENTS_NOT_CHECKED"": ""We can't read NEAR Intents incident reports without a partner key, so network delays aren't checked."",
    ""INTENTS_DEPOSIT_UNSUPPORTED"": ""This quote expects a transfer inside NEAR Intents, not a send on a network. Neer doesn't check those yet."",
    ""MEMO_EXCHANGE_WARNING"": ""Memo matches. Some exchanges have no memo field. If you can't add the memo, don't send from there."",
    ""MEMO_MATCH"": ""Memo matches. Keep it exactly as shown."",
    ""MEMO_MISMATCH"": "\`Wrong memo. Use exactly \${want}. Without the right memo, your funds can't be matched to your swap.\`",
    ""MEMO_MISSING"": ""Memo missing. This deposit needs the memo shown above. Without it, your funds can't be matched to your swap."",
    ""MEMO_UNNECESSARY"": ""This swap doesn't use a memo. You can leave it out."",
    ""MINIMUM_NETWORK_1000"": "\`Below the minimum. Swaps on \${name} under $1,000 are paused right now. Yours is \${formatUsd(usd)}. Try a larger amount or another network.\`",
    ""MINIMUM_NETWORK_UNKNOWN"": ""We couldn't look up the networks for this swap, so we can't check network minimums."",
    ""MINIMUM_RULES_PASS"": ""No blocking minimum in the published rules. Other provider limits may apply."",
    ""MINIMUM_RULES_STALE"": "\`Network minimums change. The rules last checked on \${m.checkedAt.slice(0, 10)} are no longer treated as current.\`",
    ""MINIMUM_TRON_100"": "\`Below the minimum. Swaps from Tron under $100 are paused right now. Yours is \${formatUsd(usd)}. Try a larger amount or another network.\`",
    ""MINIMUM_USD_UNKNOWN"": ""We couldn't read the dollar value of this swap, so we can't check network minimums."",
    ""NETWORK_MATCH"": "\`Right network. You're sending on \${expectedName}, which this quote expects.\`",
    ""NETWORK_MISMATCH"": "\`Wrong network. This address is for \${expectedName}. You chose \${youName}. Funds sent on \${youName} won't be swapped automatically.\`",
    ""NETWORK_NOT_SELECTED"": ""We can't see your network. Pick the one your wallet or exchange shows before you send."",
    ""ORIGIN_NETWORK_UNKNOWN"": ""We couldn't look up which network this quote expects. Try again in a minute."",
    ""ORIGIN_TOKEN_UNKNOWN"": ""We couldn't look up the token this quote expects. Try again in a minute."",
    ""PARTNER_QUOTE_MISMATCH"": ""The quote your app passed isn't the one NEAR Intents has for this address. Don't send. Get a new quote."",
    ""PLAIN_TRANSFER_REMINDER"": ""A deposit is a plain transfer. If your wallet asks you to approve spending or sign a message, stop."",
    ""QUOTE_CONFIRMED"": ""Quote confirmed by NEAR Intents."",
    ""QUOTE_DEADLINE_MISSING"": ""This quote has no deadline, so we can't tell how long it's valid. Get a fresh quote."",
    ""QUOTE_DEPOSIT_ADDRESS_MISSING"": ""This quote has no deposit address to compare with."",
    ""QUOTE_EXPIRED"": ""This quote has expired. Don't send to this address. Get a new quote from your app."",
    ""QUOTE_MEMO_MISSING"": ""This quote is in memo mode but didn't include a memo. Don't send until your app shows one."",
    ""QUOTE_NEAR_EXPIRY"": "\`\${capitalise(humanDuration(left))} left. If your send could take longer, get a fresh quote first.\`",
    ""QUOTE_PREVIEW"": ""This is a preview quote with no deposit address. Don't send to it. Get a real quote from your app."",
    ""QUOTE_TIME_AVAILABLE"": "\`\${capitalise(humanDuration(left))} left under the current timing rules. Recheck before sending.\`",
    ""QUOTE_TOO_CLOSE_TO_EXPIRY"": "\`Too close. Only \${humanDuration(left)} left, and a send on \${chain?.name ?? "this network"} can take about \${humanDuration(budget)}. Get a fresh quote.\`",
    ""QUOTE_UNVERIFIED"": ""We couldn't confirm this quote came from NEAR Intents. Don't send."",
    ""RECIPIENT_CONFIDENTIAL"": ""This quote pays a confidential NEAR Intents recipient, which Neer can't compare with your address. Check the receiving address in your swap app."",
    ""RECIPIENT_FORWARDED"": "\`The quote pays \${shortAddress(quoted)}, which passes the funds on to another address or contract, so Neer can't confirm where they end up. Check the final receiving address in your swap app.\`",
    ""RECIPIENT_LOOKALIKE"": "\`The quote's recipient starts and ends like your address \${shortAddress(expected)}, but the middle is different. Don't send. Get a new quote to an address copied from your own wallet.\`",
    ""RECIPIENT_MATCH"": "\`Your receiving address matches the quote's recipient, \${shortAddress(target)} \${place}. Neer does not check delivery on the destination network.\`",
    ""RECIPIENT_MISMATCH"": "\`The quote sends the swapped funds to \${shortAddress(target)}, not your address \${shortAddress(expected)}. Don't send. Get a new quote to your own address.\`",
    ""RECIPIENT_NETWORK_MISMATCH"": "\`The quote delivers \${where}, but you expect to receive on \${chainName(wantChain)}. Don't send. Get a new quote for the network you want.\`",
    ""RECIPIENT_NETWORK_UNKNOWN"": ""We couldn't look up which network this quote delivers to, so we can't compare the receiving address. Try again in a minute."",
    ""RECIPIENT_NOT_PROVIDED"": "\`The quote sends the swapped funds to \${shortAddress(quoted)}. Enter your own receiving address so Neer can compare it with the quote.\`",
    ""REFUND_ADDRESS_INFORMATION"": "\`The quote lists \${shortAddress(to)} for refunds. Make sure you control it. Neer cannot guarantee refund delivery.\`",
    ""REFUND_ADDRESS_INVALID"": "\`This refund address won't work on \${name}. If the swap fails, your refund can't reach you.\`",
    ""REFUND_DIFFERS_FROM_SENDER"": "\`The quoted refund address differs from your declared sender. Make sure you control \${shortAddress(to)}; Neer cannot verify ownership.\`",
    ""REFUND_FORMAT_UNSUPPORTED"": "\`We don't check \${name} addresses yet. Make sure you control \${shortAddress(to)}.\`",
    ""REFUND_MATCHES_SENDER"": "\`The quote lists \${shortAddress(to)} for refunds, matching your declared sender. Neer does not verify ownership or guarantee a refund.\`",
    ""REFUND_NETWORK_UNKNOWN"": ""We couldn't check the refund address because we don't know the network."",
    ""REFUND_TO_DEPOSIT_ADDRESS"": ""The quote sends refunds back to its deposit address. Request a new quote with a separate address you control."",
    ""REFUND_TO_INTENTS"": "\`The quote lists NEAR Intents account \${shortAddress(to)} for refunds. Neer does not verify account ownership or refund delivery.\`",
    ""SEND_ADDRESS_INVALID"": ""The address on your send screen has an invalid format or checksum. Copy it again from your swap app."",
    ""SOURCE_EXCHANGE"": "\`Sending from an exchange? They often take a fee from the amount and can be slow. Make sure at least \${fmtOrigin(c, BigInt(need))} arrives, and that refunds go to a wallet you control.\`",
    ""SOURCE_UNKNOWN"": ""Tell us if you're sending from your own wallet or from an exchange."",
    ""SOURCE_WALLET"": ""Sending from your own wallet."",
    ""STATUS_STALE"": "\`We last read this quote \${humanDuration(age)} ago. Run the checks again before you send.\`",
    ""SWAP_TYPE_UNSUPPORTED"": ""This quote type collects deposits for partner apps and is not meant for personal sends. Neer doesn't support it."",
    ""TOKEN_CONTRACT_MISMATCH"": "\`Same name, different token. The quote wants \${want.symbol} \${want.contractAddress ? shortAddress(want.contractAddress) : "(native)"}, but you picked \${got.symbol} \${got.contractAddress ? shortAddress(got.contractAddress) : "(native)"}. Check the token in your wallet.\`",
    ""TOKEN_MATCH"": "\`Right token. \${wantName} matches the quote.\`",
    ""TOKEN_NETWORK_MISMATCH"": ""The selected asset ID belongs to another network. Choose the token on the quote's origin network."",
    ""TOKEN_NOT_SELECTED"": ""Tell us which token you're sending so we can compare it with the quote."",
    ""TOKEN_PRICE_STALE"": "\`Prices are \${humanDuration(pAge)} old, so the dollar value is approximate. Token amounts are still exact.\`",
    ""TOKEN_SYMBOL_MATCH_NETWORK_BLOCKED"": "\`\${got.symbol} has the same symbol. The network check reports the mismatch.\`",
    ""TOKEN_SYMBOL_MISMATCH"": "\`Wrong token. The quote expects \${want.symbol}. You're about to send \${got.symbol}.\`",
    ""TOKEN_UNACCEPTED_CONTRACT"": "\`Wrong token. This token isn't one NEAR Intents accepts on \${chainName(c.originChain!)}. The quote expects \${want.symbol}\${want.contractAddress ? \` at \${shortAddress(want.contractAddress)}\` : ""}.\`",
    ""TOKEN_UNRECOGNISED"": "\`We don't recognise this token on \${lookupChain ? chainName(lookupChain) : "that network"}, so we can't compare it with the quote.\`",
    ""XRP_ADDRESS_INVALID"": ""This isn't a valid XRP address. Use an XRP address of your own wallet, without a tag."",
    ""XRP_ADDRESS_SUPPORTED"": ""XRP address format is supported."",
    ""XRP_DESTINATION_TAG_UNSUPPORTED"": ""XRP destination tags aren't supported for this swap. Use an XRP address of your own wallet, without a tag."",
    ""XRP_XADDRESS_WARNING"": ""This XRP X-address includes a destination tag, which may not be supported. Use a classic r… address of your own wallet."",
  },
}
`;
