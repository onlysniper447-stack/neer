{
  "name": "@neer/core",
  "version": "0.1.0",
  "description": "Neer rules engine: deterministic preflight checks for NEAR Intents 1Click deposits",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "viem": "2.57.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "json-stable-stringify": "1.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
