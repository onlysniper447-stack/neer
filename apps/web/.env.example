# All optional. Neer runs with none of these set.

# Distributed rate limiting (Upstash Redis). Without these, limits are kept in
# each server instance's memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 1Click partner JWT. Not needed for /v0/status, /v0/tokens or quotes.
ONECLICK_JWT=

# Exact origins allowed to call /api/v1/* from a browser (e.g. for <NeerGuard/>), comma-separated.
NEER_CORS_ORIGINS=

# Test only. Ignored unless the URL is loopback.
# NEER_TEST_UPSTREAM=http://127.0.0.1:4010
# NEER_TEST_QUOTE_PUBKEY=ed25519:...
# NEER_DISABLE_RATE_LIMIT=1
